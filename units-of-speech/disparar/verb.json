{"transcript":"diʃ.pɐˈɾaɾ","exists":true,"definitions":["Atirar, lançar um projétil.","Pôr em funcionamento um mecanismo que lança algo.","Aumentar subitamente e rapidamente.","Dizer ou fazer algo de forma impulsiva e sem pensar.","Desferir um golpe ou ataque."],"examples":["Ele vai disparar o alarme.","Os preços começaram a disparar.","Não devias disparar essas palavras.","O caçador conseguiu disparar a tempo.","A máquina pode disparar automaticamente."],"lemma":"disparar","lemmaPos":"verb","synonyms":["atirar","lançar","arremessar","disparatar","aumentar"],"number":"singular","tense":"present","pastTenses":"disparou (past simple), tinha disparado (past perfect)","source":"disparar","frequency":6}